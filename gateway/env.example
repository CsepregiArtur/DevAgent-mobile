# DevAgent gateway - configurare serviciu
# Copiați în /etc/deepseek-devagent.env și rulați:  chmod 600 /etc/deepseek-devagent.env
#
# Tokenul PWA (folosit de interfața mobilă / aplicația iOS). Minim 16 caractere,
# recomandat 48+ aleatorii:  openssl rand -hex 32
DEVAGENT_TOKEN="SCHIMBA-MA-cu-un-token-aleatoriu-de-minim-32-caractere"

# Token separat pentru agenți (MacBook). Dacă lipsește, se folosește DEVAGENT_TOKEN.
DEVAGENT_AGENT_TOKEN="SCHIMBA-MA-token-agent-diferit-de-cel-pwa"

# Rețea
DEVAGENT_HOST="127.0.0.1"
DEVAGENT_PORT="8082"
DEVAGENT_ROOT_PATH="/mobile"

# Persistență + evenimente în timp real
DEVAGENT_DATABASE="/var/lib/devagent/gateway.sqlite3"
DEVAGENT_REDIS_URL="redis://127.0.0.1:6379/0"

# PWA compilat (npm run build în /opt/deepseek-proxy/mobile)
DEVAGENT_STATIC_DIR="/opt/deepseek-proxy/mobile/dist"

# Workspace-uri permise pe MacBook (prima valoare = implicită).
DEVAGENT_WORKSPACES="~/dev/mobile-agent-platform,~/dev/customer-dashboard,~/dev/infrastructure-iac"
DEVAGENT_DEFAULT_WORKSPACE="~/dev/mobile-agent-platform"

# Model implicit afișat în PWA + endpoint-ul LLM folosit de agent (proxy privat DeepSeek)
DEVAGENT_DEFAULT_MODEL="DeepSeek-Coder-V2.5"
DEVAGENT_DEEPSEEK_BASE_URL="https://deepseek-api.cs-hub.xyz/v1"

# Liveness / reluare
DEVAGENT_HEARTBEAT_SECONDS="10"
DEVAGENT_AGENT_OFFLINE_SECONDS="45"
DEVAGENT_QUEUE_SCAN_MS="2000"

# Expirare aprobări: 0 = niciodată. Ex.: 3600 = propunerea expiră într-o oră.
DEVAGENT_APPROVAL_TIMEOUT_SECONDS="0"
