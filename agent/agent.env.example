# DevAgent agent - configurare MacBook
# Copiați în ~/.devagent/agent.env și rulați:  chmod 600 ~/.devagent/agent.env

# Canalul de control (WebSocket inițiat de MacBook; merge prin NAT/hotel Wi-Fi)
DEVAGENT_GATEWAY_URL="wss://deepseek-api.cs-hub.xyz/mobile/agent/ws"
DEVAGENT_AGENT_TOKEN="ACELASI-TOKEN-CA-DEVAGENT_AGENT_TOKEN-DE-PE-SERVER"
DEVAGENT_AGENT_ID="macbook-artur"

# Directorii în care agentul are voie să lucreze (whitelist absolut).
DEVAGENT_WORKSPACES="/Users/artur/dev"
# Stare locală (worktree-uri izolate + puncte de reluare)
DEVAGENT_STATE_DIR="/Users/artur/.devagent"

# Ritm de raportare; sub această valoare gateway-ul consideră agentul offline.
DEVAGENT_HEARTBEAT_SECONDS="10"

# Endpoint LLM (proxy-ul privat DeepSeek, compatibil OpenAI) + tokenul proxy-ului.
# Fără el, agentul intră în modul "plan manual" (nu modifică surse automat).
DEVAGENT_LLM_BASE_URL="https://deepseek-api.cs-hub.xyz/v1"
DEVAGENT_LLM_TOKEN="PROXY_SECRET_KEY-de-pe-server"
DEVAGENT_MODEL="DeepSeek-Coder-V2.5"

# Execuție
DEVAGENT_APPROVE_COMMANDS="true"   # comenzile de test cer aprobare separată
DEVAGENT_TEST_COMMAND=""           # gol = autodetectare (npm test, pytest, go test...)
DEVAGENT_COMMAND_TIMEOUT="900"
DEVAGENT_DRY_RUN="false"           # true = generează patch-ul dar nu îl aplică

# Publicare
DEVAGENT_PUSH_BRANCH="false"       # true = push pe branch-ul agent/<task>
DEVAGENT_CREATE_PR="false"         # true + gh instalat = deschide Pull Request
DEVAGENT_COMMIT_GATE="false"       # true = al doilea gate de aprobare înainte de commit
